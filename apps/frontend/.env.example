# Backend origin used by the Vite dev server proxy for `/api` requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Amazon Cognito (OIDC) settings. These are public client identifiers, not secrets.
VITE_OIDC_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_tZMgvVWwX
VITE_OIDC_CLIENT_ID=6f6hhjk5kvtmpg02mk42me5op6
# Must exactly match an allowed callback URL on the Cognito app client.
# Defaults to the current origin when unset.
VITE_OIDC_REDIRECT_URI=http://localhost:5173

# Cognito hosted UI domain, used for sign-out, e.g. https://<prefix>.auth.us-east-1.amazoncognito.com
# When unset, "Sign out" only clears the local session.
VITE_COGNITO_DOMAIN=
# Must exactly match an allowed sign-out URL on the Cognito app client.
# Defaults to the current origin when unset.
VITE_OIDC_LOGOUT_URI=http://localhost:5173
