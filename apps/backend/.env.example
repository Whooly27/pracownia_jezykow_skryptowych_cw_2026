# Copy to `.env` for local development. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/psj

# File bytes. The default stores them on disk in apps/backend/blobdata as a
# stand-in for Vercel Blob; leave BLOB_BASE_URL empty behind the frontend proxy.
STORAGE_BACKEND=apps.uploads.storage.LocalBlobStorage
BLOB_ROOT=blobdata
BLOB_BASE_URL=
